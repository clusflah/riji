<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/wc_card_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.47"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ag_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-light"
                android:textSize="40sp"
                android:textColor="@color/wc_text" />

            <ImageView
                android:id="@+id/ag_div1"
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:background="@color/wc_divider" />

            <TextView
                android:id="@+id/ag_lunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:textSize="12sp"
                android:textColor="@color/wc_muted" />

            <ImageView
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:background="@color/wc_divider" />

            <TextView
                android:id="@+id/ag_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/wc_red" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/ag_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="15sp"
                android:textColor="@color/wc_muted" />

            <TextView
                android:id="@+id/ag_ev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="15sp"
                android:textColor="@color/wc_text"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.53"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:gravity="top">

        <TextView
            android:id="@+id/ag_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="@color/wc_muted"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ag_i1_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ag_i1_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="10.5sp"
                android:textColor="@color/wc_muted" />

            <LinearLayout
                android:id="@+id/ag_i1_chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/wc_chip_holiday">

                <ImageView
                    android:id="@+id/ag_i1_dot"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:padding="3.5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/wc_ic_cal"
                    android:background="@drawable/wc_dot_holiday" />

                <TextView
                    android:id="@+id/ag_i1_t0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_holiday_fg"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/ag_i1_t1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_birthday_fg"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ag_i1_t2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_reminder_fg"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ag_i1_t3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_alarm_fg"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ag_i1_t4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_diary_fg"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ag_i1_t5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_work_fg"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ag_i2_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ag_i2_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="10.5sp"
                android:textColor="@color/wc_muted" />

            <LinearLayout
                android:id="@+id/ag_i2_chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/wc_chip_holiday">

                <ImageView
                    android:id="@+id/ag_i2_dot"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:padding="3.5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/wc_ic_cal"
                    android:background="@drawable/wc_dot_holiday" />

                <TextView
                    android:id="@+id/ag_i2_t0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_holiday_fg"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/ag_i2_t1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_birthday_fg"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ag_i2_t2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_reminder_fg"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ag_i2_t3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_alarm_fg"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ag_i2_t4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_diary_fg"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ag_i2_t5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/wc_chip_work_fg"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
